# Copy to .env.local (git-ignored) and fill in.
#
#   cp .env.example .env.local
#
# You need exactly one API key. Everything else here has a working default.

# ---------- the key ----------
# Provider-neutral: paste a key from any supported provider and Achilles works
# out which one it is from the key's shape. This is the simplest way in.
# ACHILLES_API_KEY=

# Or use the provider's conventional variable. These are checked in this order,
# so a machine holding several keys defaults to the calibrated path (Anthropic).
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
# GEMINI_API_KEY=AIza...
# DEEPSEEK_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# XAI_API_KEY=xai-...
# OPENROUTER_API_KEY=sk-or-v1-...
#
# GitHub Models needs its own variable rather than GITHUB_TOKEN, which CI sets
# automatically for unrelated reasons and must never be routed to inference.
# GITHUB_MODELS_TOKEN=github_pat_...

# ---------- provider and model ----------
# Only needed for a gateway or self-hosted endpoint whose key shape we can't
# recognise. Run `achilles providers` for the full list.
#   anthropic | openai | google | deepseek | groq | xai | openrouter | github
# ACHILLES_PROVIDER=

# Defaults to the chosen provider's flagship (claude-opus-5, gpt-5,
# gemini-2.5-pro, deepseek-reasoner, ...). Set to override.
# ACHILLES_MODEL=

# Point an OpenAI-compatible provider at a different host — LiteLLM, vLLM, an
# Azure deployment, or any other gateway that speaks /chat/completions.
# ACHILLES_BASE_URL=

# Effort: low | medium | high | xhigh | max. `high` is the quality/latency sweet
# spot. Ignored by models that have no reasoning-effort control.
ACHILLES_EFFORT=high

# ---------- behaviour ----------
# Set to 1 to require every visitor to supply their own key (no server-key
# fallback), so a public deploy never spends the owner's credits.
ACHILLES_BYO_KEY_ONLY=0

# Ceiling on tailor -> render -> grade cycles.
# ACHILLES_MAX_PASSES=3

# PDF backend: typst | pdfspark
#   typst    - default. Offline, deterministic, no network hop. The one-page
#              geometry was tuned against it.
#   pdfspark - renders HTML/CSS via pdfspark.dev's headless Chromium. Easier to
#              restyle, but adds ~1.2s and a network dependency per render.
ACHILLES_RENDERER=typst

# Only needed to point at a self-hosted PDFSpark.
# PDFSPARK_BASE_URL=https://pdfspark.dev
