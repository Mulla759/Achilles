# Copy to .env.local (git-ignored) and fill in.
#
#   cp .env.example .env.local
#
# The server key is the fallback used when a visitor does not bring their own.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Model used for tailoring. Opus 5 is the default and what the rubric was tuned on.
ACHILLES_MODEL=claude-opus-5

# Effort: low | medium | high | xhigh | max. `high` is the quality/latency sweet spot.
ACHILLES_EFFORT=high

# Set to 1 to require every visitor to supply their own key (no server-key fallback).
ACHILLES_BYO_KEY_ONLY=0

# PDF backend: typst | pdfspark
#   typst    - default. Offline, deterministic, no network hop. The one-page
#              geometry was tuned against it.
#   pdfspark - renders HTML/CSS via pdfspark.dev's headless Chromium. Easier to
#              restyle, but adds ~1.2s and a network dependency per render.
ACHILLES_RENDERER=typst

# Only needed to point at a self-hosted PDFSpark.
# PDFSPARK_BASE_URL=https://pdfspark.dev
