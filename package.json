{
  "name": "achilles",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "next dev",
    "dev:api": "python scripts/devapi.py --port 8787",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "pytest tests -q",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "motion": "13.1.0",
    "next": "15.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "concurrently": "^9.2.1",
    "typescript": "5.9.3"
  }
}
